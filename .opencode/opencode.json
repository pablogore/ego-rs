{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "models": {
        "qwen-fast": {
          "name": "Qwen2.5 Coder 7B Instruct Q4_K_M (via LiteLLM)",
          "limit": {
            "context": 16384,
            "output": 700
          }
        },
        "qwen-heavy": {
          "name": "Qwen2.5 Coder 14B Instruct Q4_K_M (via LiteLLM)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen-architect": {
          "name": "Qwen3.6 35B A3B UD Q4_K_M (via LiteLLM)",
          "limit": {
            "context": 16384,
            "output": 220
          }
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM local",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "qwen-fast": {
          "name": "Qwen2.5 Coder 7B Instruct Q4_K_M",
          "limit": {
            "context": 16384,
            "output": 700
          }
        },
        "qwen-heavy": {
          "name": "Qwen2.5 Coder 14B Instruct Q4_K_M",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen-architect": {
          "name": "Qwen3.6 35B A3B UD Q4_K_M",
          "limit": {
            "context": 16384,
            "output": 220
          }
        }
      }
    }
  },
  "model": "litellm/qwen-heavy",
  "small_model": "litellm/qwen-heavy",
  "compaction": {
    "auto": false,
    "tail_turns": 1
  },
  "plugin": [
    "./plugins/execution-guard.ts"
  ]
}
