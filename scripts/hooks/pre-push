#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: runs clippy and tests before allowing push
# Installed via: ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd "$SCRIPT_DIR/../.." && pwd))"
cd "$REPO_ROOT"

echo "Running pre-push checks..."

echo ""
echo "==> cargo clippy --workspace -- -D warnings"
if ! cargo clippy --workspace -- -D warnings; then
    echo "ERROR: clippy checks failed. Fix warnings before pushing."
    exit 1
fi

echo ""
echo "==> make buf"
if ! make buf; then
    echo "ERROR: Buf checks failed. Fix Buf issues before pushing."
    exit 1
fi

echo ""
echo "==> cargo test --workspace"
if ! cargo test --workspace; then
    echo "ERROR: tests failed. Fix failing tests before pushing."
    exit 1
fi

echo ""
echo "All pre-push checks passed."
exit 0
